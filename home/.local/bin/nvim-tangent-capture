#!/usr/bin/env bash
# nvim-tangent-capture -- capture a tangent into the vault from outside nvim.
#
# This is the entry point for everything that is not `<leader>nT`: the Cinnamon
# hotkey, the wezterm binding, a tmux binding, a shell alias. It finds the
# editor you are actually looking at and asks it to open the capture float, so
# the write path and the format stay in exactly one place
# (~/.config/nvim/lua/custom/tangent-capture.lua).
#
# Finding that editor is shared with nvim-daily-note and lives in
# ~/.local/lib/nvim-editor-socket.sh; what is specific to this script is what to
# run there and what to do when no editor is running.
#
# Run `nvim-tangent-capture --diagnose` to see which editor it would pick.
set -uo pipefail

EXPR='execute("TangentCapture")'
PING='exists(":TangentCapture")'

LIB="${HOME}/.local/lib/nvim-editor-socket.sh"
if [[ ! -r "$LIB" ]]; then
  printf 'nvim-tangent-capture: %s is missing (stow not run?)\n' "$LIB" >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$LIB"

usage() {
  command sed -n '2,14p' "$0" | command sed 's/^# \{0,1\}//'
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --diagnose) diagnose=1; verbose=1 ;;
  "") ;;
  *) printf 'nvim-tangent-capture: unknown argument %s\n' "$1" >&2; usage >&2; exit 2 ;;
esac

# --- main --------------------------------------------------------------------

chosen="$(nvim_editor_socket "$EXPR" "$PING")" || true

if [[ -n "$chosen" ]]; then
  say "chosen: $chosen"
  if (( diagnose )); then
    printf 'nvim-tangent-capture: would capture in %s\n' "$chosen"
    exit 0
  fi
  exit 0
fi

if (( diagnose )); then
  printf 'nvim-tangent-capture: no running editor; a new one would be started\n'
  exit 0
fi

# Nothing is running. Start an editor whose only job is the float, and have it
# quit when the tangent is saved or cancelled (`:TangentCapture!`).
nvim_cmd=(nvim -c 'lua require("custom.tangent-capture").capture({ oneshot = true })')

if ! command -v nvim >/dev/null 2>&1; then
  command -v notify-send >/dev/null 2>&1 &&
    notify-send -a tangent "Tangent not captured" "nvim is not installed."
  exit 1
fi

if [[ -t 0 && -t 1 ]]; then
  # We own a terminal (the hotkey was pressed from a shell): take it over.
  exec "${nvim_cmd[@]}"
fi

if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && command -v wezterm >/dev/null 2>&1; then
  # --cwd so the placeholder editor does not inherit a random directory. No
  # --always-new-process: handing the spawn to the running GUI is faster and
  # still ends in its own window.
  exec wezterm start --cwd "$HOME" -- "${nvim_cmd[@]}"
fi

if [[ -n "${DISPLAY:-}" ]] && command -v x-terminal-emulator >/dev/null 2>&1; then
  exec x-terminal-emulator -e "${nvim_cmd[@]}"
fi

if command -v notify-send >/dev/null 2>&1; then
  notify-send -a tangent "Tangent not captured" "No running nvim, and no terminal available to start one."
else
  printf 'nvim-tangent-capture: no running nvim, and no terminal available to start one\n' >&2
fi
exit 1
